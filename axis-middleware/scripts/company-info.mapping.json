      "gst": { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
      "cin": { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
      "msme": { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
      "msmeType": { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
      "msmeClassification": { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
      "tenant_id": { "type": "keyword" },
      "searchable_text": { "type": "text" },
      "embedding": { "type": "knn_vector", "dimension": 384 }
    }
  }
}
